<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zaara-mall</title>
<style>
body{font-family:Arial;margin:0;background:#fff8f5;color:#333}
header{background:#241713;color:white;text-align:center;padding:25px}
h1{margin:0;color:#f3c987}
main{padding:20px;text-align:center}
.products{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.item{background:white;padding:15px;border-radius:12px;box-shadow:0 2px 8px #ddd}
.item img{width:100%;height:150px;object-fit:cover;border-radius:8px}
button{background:#16834a;color:white;border:0;padding:12px;border-radius:7px}
a{color:white;text-decoration:none}
footer{text-align:center;padding:20px}
</style>
</head>
<body>
<header>
<h1>ZAARA-MALL</h1>
<p>Welcome to our online shop</p>
</header>
<main>
<h2>Our Products</h2>
<div class="products">
<div class="item">
<img src="https://placehold.co/300x200?text=Clothes" alt="Clothes">
<h3>Women's Clothes</h3>
<p>Price: Add your price</p>
</div>
<div class="item">
<img src="https://placehold.co/300x200?text=Bags" alt="Bags">
<h3>Bags</h3>
<p>Price: Add your price</p>
</div>
<div class="item">
<img src="https://placehold.co/300x200?text=Shoes" alt="Shoes">
<h3>Shoes</h3>
<p>Price: Add your price</p>
</div>
<div class="item">
<img src="https://placehold.co/300x200?text=Perfume" alt="Perfume">
<h3>Perfumes</h3>
<p>Price: Add your price</p>
</div>
</div>
<h2>Order on WhatsApp</h2>
<p>Contact us to order your products.</p>
<button><a href="https://wa.me/256700000000">Chat on WhatsApp</a></button>
</main>
<footer>© 2026 Zaara-mall</footer>
</body>
</html>
